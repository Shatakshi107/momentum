# Copy to .env.local and fill in. Without ANTHROPIC_API_KEY the app runs in mock mode.
ANTHROPIC_API_KEY=
# Optional: raises GitHub rate limit from 60 to 5000 req/hour (read-only public scope is enough)
GITHUB_TOKEN=
# Optional: force mock mode even with a key (saves credits while styling UI)
MOCK=
# Optional: override the model
# CLAUDE_MODEL=claude-opus-5-5
# Optional chat integrations (incoming webhooks). Without them, "send" is simulated.
# Discord: Channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Optional separate private channel for organizer alerts (falls back to the one above)
DISCORD_ORGANIZER_WEBHOOK_URL=
# Slack: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
